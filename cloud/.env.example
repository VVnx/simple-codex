# Fill in via your server's secret manager or a chmod 600 cloud/.env file.
# Never commit tokens. Values below are placeholders, not usable credentials.
SLACK_USER_TOKEN=xoxp-replace-securely
SLACK_TEAM_ID=T_REPLACE
SLACK_OWNER_ID=U_REPLACE
SLACK_DOT_DM_ID=D_REPLACE
SLACK_DOT_USER_ID=U_REPLACE
SLACK_DOT_BOT_ID=B_REPLACE
WECHAT_CREDENTIALS_FILE=/data/wechat-credentials.json
BRIDGE_WINDOW_SECONDS=86400
